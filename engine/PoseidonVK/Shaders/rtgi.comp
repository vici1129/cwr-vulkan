#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require
#include "rtao_depth.glsl"
#include "rtgi_receiver.glsl"
#include "rtgi_sample.glsl"
#include "rtgi_history.glsl"
#include "ray_material.glsl"
#include "ray_surface.glsl"
#define GI_GROUP_LIGHTING
#include "ray_lighting.glsl"
#define WEATHER_SET 1
#include "weather.glsl"
#include "diffuse_sky_math.glsl"
#include "ray_sky.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=1) uniform accelerationStructureEXT scene;
layout(set=0,binding=2,rgba32f) uniform image2D resultGI;
layout(set=0,binding=3,std430) buffer Counters { uint count[]; } counters;
#ifdef MULTISAMPLE_DEPTH
layout(set=0,binding=6) uniform sampler2DMS replacedAmbient;
vec4 capturedAmbient(ivec2 p) { return texelFetch(replacedAmbient,p,0); }
#else
layout(set=0,binding=6) uniform sampler2D replacedAmbient;
vec4 capturedAmbient(ivec2 p) { return texelFetch(replacedAmbient,p,0); }
#endif
shared uint counts[48];
shared vec3 skyDomeIntegral[64],skyWeatherIntegral[64],skyWallIntegral[64];
shared vec4 reflectanceIntegral[64];
layout(constant_id=0) const bool GIPathProbe=false;
layout(constant_id=1) const bool GISecondBounce=false;
int pathProbe=-1;
void probeValue(int row,vec4 value) {
    if(!GIPathProbe || pathProbe<0) return;
    for(int i=0;i<4;++i) counters.count[104+pathProbe*96+row*4+i]=floatBitsToUint(value[i]);
}
void beginProbe(ivec2 pixel) {
    if(!GIPathProbe) return;
    ivec2 size=imageSize(resultGI),cell=clamp(pixel*8/size,ivec2(0),ivec2(7));
    ivec2 selected=ivec2((vec2(cell)+.5)*vec2(size)/8);
    if(all(equal(pixel,selected))) pathProbe=cell.y*8+cell.x;
}
vec3 calibratedSky(vec3 world,vec3 direction) {
    return raySkyLinear(world,direction)*uintBitsToFloat(counters.count[51]);
}
// A small deterministic quadrature of the existing sky lookup, not extra rays.
// Independent of receivers, material color, occlusion and final image brightness.
void measureSkyIrradiance() {
    uint lane=gl_LocalInvocationIndex;
    vec3 dome=vec3(0),cloudy=vec3(0),wall=vec3(0);
    vec3 normal=vec3(-ao.camera[2].x,0,-ao.camera[2].z);
    normal=dot(normal,normal)>1e-6?normalize(normal):vec3(0,0,1);
    for(uint j=0;j<16;++j) {
        uint i=lane+j*64;
        float u=(float(i/32)+.5)/32,phi=6.2831853*(float(i%32)+.5)/32;
        vec3 d=giCosineDirection(vec3(0,1,0),u,phi);
        vec3 base=raySkyDomeLinear(d);
        dome+=base/1024;
        cloudy+=raySkyWeatherLinear(ao.camera[3].xyz,d,base)/1024;
        d=giCosineDirection(normal,u,phi);
        wall+=raySkyLinear(ao.camera[3].xyz,d)/1024;
    }
    skyDomeIntegral[lane]=dome;skyWeatherIntegral[lane]=cloudy;skyWallIntegral[lane]=wall;
    barrier();
    for(uint step=32;step>0;step/=2) {
        if(lane<step) {
            skyDomeIntegral[lane]+=skyDomeIntegral[lane+step];
            skyWeatherIntegral[lane]+=skyWeatherIntegral[lane+step];
            skyWallIntegral[lane]+=skyWallIntegral[lane+step];
        }
        barrier();
    }
    if(lane==0) {
        for(uint c=0;c<3;++c) {
            counters.count[48+c]=floatBitsToUint(skyDomeIntegral[0][c]);
            counters.count[52+c]=floatBitsToUint(skyWeatherIntegral[0][c]);
            counters.count[56+c]=floatBitsToUint(skyWallIntegral[0][c]);
            counters.count[60+c]=floatBitsToUint(rayAmbientLinear()[c]);
        }
        counters.count[51]=floatBitsToUint(giSkyCalibration(rayAmbientLinear(),skyDomeIntegral[0]));
    }
}
// Sparse, generic frame diagnostics BEFORE ambient composition/AA/tone mapping.
// Reads existing transport/receiver/ambient images; no scene-specific ROI or rays.
void measureTransport() {
    uint lane=gl_LocalInvocationIndex;
    vec3 incoming=vec3(0),replacement=vec3(0),ambient=vec3(0);
    vec4 reflectance=vec4(0);
    for(uint j=0;j<16;++j) {
        uint i=lane+j*64;
        ivec2 q=ivec2((vec2(i%32,i/32)+.5)*vec2(imageSize(resultGI))/32);
        ivec2 full=min(q*2+1,depthSize()-1);
        vec4 receiver=giReceiver(full),sampleGI=imageLoad(resultGI,q),old=capturedAmbient(full);
        if(receiver.w>=0 || sampleGI.a==0 || old.w>=0 || !rtSameDepth(-old.w,-receiver.w)) continue;
        incoming+=sampleGI.rgb;replacement+=receiver.rgb*sampleGI.rgb;ambient+=old.rgb;
        reflectance+=vec4(receiver.rgb,1);
    }
    skyDomeIntegral[lane]=incoming;skyWeatherIntegral[lane]=replacement;skyWallIntegral[lane]=ambient;
    reflectanceIntegral[lane]=reflectance;
    barrier();
    for(uint step=32;step>0;step/=2) {
        if(lane<step) {
            skyDomeIntegral[lane]+=skyDomeIntegral[lane+step];
            skyWeatherIntegral[lane]+=skyWeatherIntegral[lane+step];
            skyWallIntegral[lane]+=skyWallIntegral[lane+step];
            reflectanceIntegral[lane]+=reflectanceIntegral[lane+step];
        }
        barrier();
    }
    if(lane==0) {
        float samples=reflectanceIntegral[0].w,inv=1/max(samples,1);
        for(uint c=0;c<3;++c) {
            counters.count[64+c]=floatBitsToUint(skyDomeIntegral[0][c]*inv);
            counters.count[68+c]=floatBitsToUint(skyWeatherIntegral[0][c]*inv);
            counters.count[72+c]=floatBitsToUint(skyWallIntegral[0][c]*inv);
            counters.count[76+c]=floatBitsToUint(reflectanceIntegral[0][c]*inv);
        }
        counters.count[67]=floatBitsToUint(samples);
    }
}
bool skyBlocked(vec3 origin,vec3 direction,float minimum,inout float sampleData) {
    rayQueryEXT sky;
    rayQueryInitializeEXT(sky,scene,gl_RayFlagsTerminateOnFirstHitEXT,255,origin,minimum,direction,80.0);
    while(rayQueryProceedEXT(sky)) {
        if(rayQueryGetIntersectionTypeEXT(sky,false)==gl_RayQueryCandidateIntersectionTriangleEXT && opaqueHit(sky))
            rayQueryConfirmIntersectionEXT(sky);
    }
    bool blocked=rayQueryGetIntersectionTypeEXT(sky,true)==gl_RayQueryCommittedIntersectionTriangleEXT;
    if(blocked && (rayQueryGetIntersectionInstanceCustomIndexEXT(sky,true)>>20)==3u) sampleData=-abs(sampleData);
    return blocked;
}
// The same reconstruction/wetness and direct-light estimator at both endpoints.
void giWetSurface(inout HitSurface hit) {
    if(hit.kind==2u && hit.materialIdentity==1000u) {
        float exposure=smoothstep(.15,.8,hit.geometricNormal.y)*smoothstep(0.0,.35,hit.position.y-light.parameters.w);
        hit.albedo*=1-hit.terrainWetResponse*light.parameters.z*exposure;
    }
}
vec3 giDirectSurface(HitSurface hit,uint hash,inout float sampleData,bool second,uint sourceCounter) {
    int base=second?12:0;
    vec3 sun=normalize(ao.sun.xyz);
    float cosine=max(dot(hit.normal,sun),0);
    // Never illuminate the reverse geometric side, even with a smoothed normal.
    if(dot(hit.geometricNormal,sun)<=0) cosine=0;
    if(cosine<=0 && !second) atomicAdd(counts[14],1);
    float visibility=0;
    if(cosine>0 && max(max(raySunlightLinear().r,raySunlightLinear().g),raySunlightLinear().b)>.00001) {
        rayQueryEXT shadow;
        rayQueryInitializeEXT(shadow,scene,gl_RayFlagsTerminateOnFirstHitEXT,255,
            hit.position+hit.geometricNormal*.02,.005,sun,80.0);
        while(rayQueryProceedEXT(shadow)) {
            if(rayQueryGetIntersectionTypeEXT(shadow,false)==gl_RayQueryCandidateIntersectionTriangleEXT && opaqueHit(shadow))
                rayQueryConfirmIntersectionEXT(shadow);
        }
        atomicAdd(counts[second?44:4],1);
        bool blocked=rayQueryGetIntersectionTypeEXT(shadow,true)==gl_RayQueryCommittedIntersectionTriangleEXT;
        if(blocked) {
            atomicAdd(counts[second?45:5],1);
            if((rayQueryGetIntersectionInstanceCustomIndexEXT(shadow,true)>>20)==3u)
                sampleData=-abs(sampleData);
        }
        visibility=blocked?0:cloudSunlight(hit.position);
        if(!second && visibility>0) atomicAdd(counts[sourceCounter+1],1);
    }
    vec3 sky=vec3(0);
    if(giSkyComponent(ao.settings.z)) {
        // Independent dimensions for the hit's one cosine-weighted sky probe.
        // Reuse the existing 32-phase temporal reconstruction, not more primary rays.
        uint skyHash=hash^0x68bc21ebu;
        skyHash^=skyHash>>16;skyHash*=2246822519u;skyHash^=skyHash>>13;
        float su=(float(skyHash>>16)+.5)/65536;
        float sp=6.2831853*(float(skyHash&65535u)+.5)/65536;
        if(ao.jitter.z>0) {
            float phase=ao.jitter.z-1;
            su=fract(su+giSampleShift(phase)*.754877666);
            sp+=giSampleRotation(phase)*1.324717957;
        }
        vec3 skyDirection=giCosineDirection(hit.normal,su,sp);
        if(giSkyHemisphere(skyDirection,hit.geometricNormal)) {
            atomicAdd(counts[second?46:16],1);
            if(skyBlocked(hit.position+hit.geometricNormal*.02,skyDirection,.005,sampleData))
                atomicAdd(counts[second?47:17],1);
            else {
                if(!second) atomicAdd(counts[18],1);
                sky=calibratedSky(hit.position,skyDirection);
            }
        } else if(!second) atomicAdd(counts[19],1);
    }
    vec3 incident=giSunComponent(ao.settings.z)?raySunlightLinear()*cosine*visibility:vec3(0);
    vec3 reflected=giLambertOutgoing(hit.albedo,incident,sky);
    // Cosine/PDF and Lambertian pi cancel for this single cosine-weighted
    // sample. Incident sunlight has the same Lambert-reference calibration as
    // enhanced raster lighting. No arbitrary GI gain or hit-distance falloff.
    probeValue(base+7,vec4(hit.albedo,cosine));
    probeValue(base+8,vec4(incident,visibility));
    probeValue(base+9,vec4(hit.albedo*incident,sun.x));
    probeValue(base+10,vec4(hit.albedo*sky,sun.y));
    probeValue(base+11,vec4(reflected,sun.z));
    return reflected;
}
vec4 traceGI(ivec2 pixel) {
    beginProbe(pixel);
    ivec2 full=min(pixel*2+1,depthSize()-1);
    vec4 receiver=giReceiver(full);
    if(receiver.w>=0) return vec4(0);
    vec3 p=positionAt(full),n=giNormal(full,p);
    float distance=length(p);
    if(distance>=ao.settings.w || dot(n,n)<.5) return vec4(0);
    atomicAdd(counts[6],1);
    atomicAdd(counts[24+materialReceiverClass(giSurface(full).g)],1);
    vec3 worldNormal=normalize(mat3(ao.camera)*n);
    vec4 result=vec4(0,0,0,giSampleData(p.z,worldNormal));
    // Transport uses the original (or explicitly mapped) shading normal; spatial/history rejection and
    // offsets use the macro surface, so relief does not fragment the denoiser.
    n=materialDecodeNormal(giSurface(full).g);
    vec3 world=(ao.camera*vec4(p,1)).xyz;
    probeValue(0,vec4(world,ao.jitter.z));
    probeValue(1,vec4(n,materialReceiverClass(giSurface(full).g)));
    vec3 tangent=normalize(cross(abs(n.y)<.95?vec3(0,1,0):vec3(1,0,0),n));
    vec3 bitangent=cross(n,tangent);
    // Subpixel-scale world seeds: centimetre-sized shared seeds correlate whole
    // screen blocks, making a one-sample visibility estimate impossible to filter.
    uvec3 cell=uvec3(ivec3(floor(world*512)));
    uint hash=cell.x*1597334677u^cell.y*3812015801u^cell.z*2798796415u;
    hash^=hash>>16;hash*=2246822519u;hash^=hash>>13;
    float u=(float(hash>>16)+.5)/65536;
    float phi=6.2831853*(float(hash&65535u)+.5)/65536;
    // Thirty-two deterministic phases only with temporal AA. Off/MSAA retain the
    // original world-stable sample, without accumulating identical rays.
    if(ao.jitter.z>0) {
        float phase=ao.jitter.z-1;
        u=fract(u+giSampleShift(phase));
        phi+=giSampleRotation(phase);
    }
    vec3 direction=tangent*cos(phi)*sqrt(u)+bitangent*sin(phi)*sqrt(u)+n*sqrt(1-u);
    probeValue(2,vec4(direction,0));
    if(dot(direction,worldNormal)<=0) return result;
    vec3 origin=world+worldNormal*ao.settings.y,throughput=vec3(1);
    // A bounded loop shares traversal, reconstruction and direct shading at
    // both endpoints. The one-bounce specialization has one iteration.
    for(int bounce=0;bounce<(GISecondBounce?2:1);++bounce) {
        bool second=bounce>0;
        rayQueryEXT query;
        rayQueryInitializeEXT(query,scene,0,255,origin,.005,direction,ao.settings.x);
        while(rayQueryProceedEXT(query)) {
            if(rayQueryGetIntersectionTypeEXT(query,false)==gl_RayQueryCandidateIntersectionTriangleEXT && opaqueHit(query))
                rayQueryConfirmIntersectionEXT(query);
        }
        atomicAdd(counts[second?40:0],1);
        if(rayQueryGetIntersectionTypeEXT(query,true)!=gl_RayQueryCommittedIntersectionTriangleEXT) {
            probeValue(second?12:2,vec4(direction,1));
            // Sky at the first hit already has its own visibility estimate:
            // a continuation miss adds ZERO, never another sky/ambient sample.
            if(second) return result;
            if(direction.y>0) {
                atomicAdd(counts[20],1);
                if(skyBlocked(origin,direction,ao.settings.x,result.a))
                    atomicAdd(counts[21],1);
                else {
                    atomicAdd(counts[22],1);
                    result.rgb=calibratedSky(world,direction);
                }
            } else atomicAdd(counts[23],1);
            return result;
        }
        atomicAdd(counts[second?41:1],1);
        HitSurface hit=hitSurface(query);
        giWetSurface(hit);
        probeValue(second?12:2,vec4(direction,2));
        probeValue(second?13:3,vec4(hit.position,hit.kind));
        probeValue(second?14:4,vec4(hit.normal,hit.materialIdentity));
        probeValue(second?15:5,vec4(hit.geometricNormal,rayQueryGetIntersectionTEXT(query,true)));
        probeValue(second?16:6,vec4(hit.textureColorLinear,hit.available));
        probeValue(second?19:7,vec4(hit.albedo,0));
        if(hit.kind==3u) result.a=-abs(result.a);
        if(!hit.diffuseEligible || hit.materialIdentity==0u) {
            atomicAdd(counts[second?43:3],1);
            if(!second) {
                if((hit.available&HitColor)==0u) atomicAdd(counts[15],1);
                // Preserve the original one-bounce fallback for unconverted
                // endpoints. Unsupported SECOND endpoints add no invented light.
                result.rgb=rayAmbientLinear();
            }
            return result;
        }
        atomicAdd(counts[second?42:2],1);
        probeValue(second?12:2,vec4(direction,3));
        uint sourceCounter=hit.kind==2u?8u:hit.materialIdentity>=64u?10u:12u;
        if(!second) {
            atomicAdd(counts[sourceCounter],1);
            if(hit.kind==3u) atomicAdd(counts[7],1);
        }
        vec3 outgoing=giDirectSurface(hit,hash,result.a,second,sourceCounter);
        // cos(theta)/pi cancels PDF=cos(theta)/pi at each sampled edge.
        // Composition applies the receiver reflectance once, as before.
        vec3 transported=throughput*outgoing;
        if(second) probeValue(17,vec4(transported,0));
        result.rgb+=transported;
        probeValue(18,vec4(result.rgb,0));
        if(!GISecondBounce || second) break;
        throughput=hit.albedo;
        // Independent dimensions from the primary ray AND first-hit sky probe.
        hash^=0xb5297a4du;
        hash^=hash>>16;hash*=2246822519u;hash^=hash>>13;
        u=(float(hash>>16)+.5)/65536;
        phi=6.2831853*(float(hash&65535u)+.5)/65536;
        if(ao.jitter.z>0) {
            float phase=ao.jitter.z-1;
            u=fract(u+giSampleShift(phase)*1.220744085);
            phi+=giSampleRotation(phase)*1.618033989;
        }
        direction=giCosineDirection(hit.normal,u,phi);
        probeValue(12,vec4(direction,0));
        // Geometric back-side samples are absorbed, without resampling.
        if(dot(direction,hit.geometricNormal)<=0) break;
        origin=hit.position+hit.geometricNormal*.02;
    }
    return result;
}

void main() {
    uint lane=gl_LocalInvocationIndex;
    // These authored coefficients are constant for the dispatch. Decode each
    // once per group, sharing the existing counter-initialization barrier.
    if(lane<6) {
        vec3 color=lane==0?light.ambient.rgb:lane==1?light.diffuse.rgb:
            lane==2?light.zenith.rgb:lane==3?light.horizon.rgb:
            lane==4?light.sunSky.rgb:weather.cloudColor.rgb;
        giLighting[lane]=legacyLightToLinear(color);
    }
    if(lane<48) counts[lane]=0;
    barrier();
    if(ao.jitter.w==-1) { measureSkyIrradiance();return; }
    if(ao.jitter.w==-2) { measureTransport();return; }
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(all(lessThan(p,imageSize(resultGI)))) imageStore(resultGI,p,traceGI(p));
    barrier();
    if(gl_LocalInvocationIndex<48) {
        uint i=gl_LocalInvocationIndex;
        // Empty groups/categories contribute nothing. In particular, do not
        // serialize every group on the global diagnostic words for +0.
        if(counts[i]!=0) atomicAdd(counters.count[i<8?20+i:i<24?24+i:56+i],counts[i]);
    }
}
