#version 460
#extension GL_EXT_ray_query : require
#extension GL_EXT_buffer_reference2 : require
#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_GOOGLE_include_directive : require
#include "rtao_depth.glsl"
layout(local_size_x=8,local_size_y=8) in;
layout(set=0,binding=1) uniform accelerationStructureEXT scene;
layout(set=0,binding=2,rgba32f) uniform writeonly image2D resultAO;
layout(set=0,binding=3,std430) buffer Counters { uint rays; uint hits; uint sunRays; uint sunHits; uint terrainHits; uint alphaHits; uint waterRays; uint waterHits; uint shadedHits; uint shadedTerrain; uint shadedAlpha; uint dynamicAO; uint dynamicSun; uint dynamicWater; uint dynamicShaded; uint surfaceEligible; uint surfaceVertex; uint surfaceFace; uint surfaceUnavailable; uint surfaceInvalid; } counters;
#ifdef SUN_SHADOW
#include "sunlight_depth.glsl"
#include "soft_rt_shadow_math.glsl"
#endif
shared uint groupRays;
shared uint groupHits;
shared uint terrainHits;
shared uint alphaHits;
shared uint shadedHits;
shared uint dynamicHits;
shared uint dynamicShaded;
#ifdef WATER_REFLECTION
// Fixed when the existing water pipeline is created, not a per-hit branch.
layout(constant_id=0) const bool hitDiagnostics=false;
shared uint surfaceEligible, surfaceVertex, surfaceFace, surfaceUnavailable, surfaceInvalid;
#endif
#include "ray_material.glsl"
#if !defined(SUN_SHADOW) && !defined(WATER_REFLECTION)
#include "rtao_ambient.glsl"
#endif

#ifdef WATER_REFLECTION
#include "rtao_water.glsl"
#endif
vec4 traceAO(ivec2 pixel) {
    // Store the selected full-resolution sample's view depth for bilateral upsampling.
    ivec2 full=min(pixel*2+1,depthSize()-1);
#ifdef SUN_SHADOW
    full=pixel;
    vec4 direct=directAt(full);
    if(ao.sun.w<=0 || max(max(direct.r,direct.g),direct.b)<.00001) return vec4(0);
#endif
    float depth=depthAt(full);
    vec3 p=positionAt(full);
#if !defined(SUN_SHADOW) && !defined(WATER_REFLECTION)
    vec4 ambient=ambientAt(full);
    if(ambient.w<=0 || max(max(ambient.r,ambient.g),ambient.b)<.00001) return vec4(1,p.z,0,0);
#endif
    float cameraDistance=length(p);
    if(depth<=0 || depth>=.999999 || p.z<=0 || cameraDistance>=ao.settings.w)
#ifdef SUN_SHADOW
        return vec4(0);
#else
        return vec4(1,p.z,0,0);
#endif
    vec3 l=positionAt(full-ivec2(1,0)), r=positionAt(full+ivec2(1,0));
    vec3 t=positionAt(full-ivec2(0,1)), b=positionAt(full+ivec2(0,1));
    vec3 dx=abs(p.z-l.z)<abs(r.z-p.z)?p-l:r-p;
    vec3 dy=abs(p.z-t.z)<abs(b.z-p.z)?p-t:b-p;
    vec3 n=cross(dx,dy);
    if(dot(n,n)<1e-12)
#ifdef SUN_SHADOW
        return vec4(0);
#else
        return vec4(1,p.z,0,0);
#endif
    n=normalize(n);
    if(dot(n,p)>0) n=-n;
    n=normalize(mat3(ao.camera)*n);
    vec3 world=(ao.camera*vec4(p,1)).xyz;
#ifdef SUN_SHADOW
    if(ao.jitter.z>.5) {
        vec3 center=normalize(ao.sun.xyz);
        if(dot(n,center)<0) n=-n;
        vec3 tangent=normalize(cross(abs(center.y)<.95?vec3(0,1,0):vec3(1,0,0),center));
        vec3 bitangent=cross(center,tangent);
        // Light-plane coordinates keep the pattern fixed to the world, not the
        // screen, TAA jitter or frame number. Fine cells break four-ray bands
        // without turning contact edges into a screen-space blur.
        uvec2 cell=uvec2(ivec2(floor(vec2(dot(world,tangent),dot(world,bitangent))*64)));
        uint hash=cell.x*1597334677u ^ cell.y*3812015801u;
        hash^=hash>>16; hash*=2246822519u; hash^=hash>>13;
        float rotation=6.2831853*(float(hash&65535u)+.5)/65536;
        float radial=(float(hash>>16)+.5)/65536;
        uint hitCount=0;
        for(int i=0;i<4;++i) {
            float angle=rtSunDiskAngle(i,rotation);
            vec3 direction=normalize(center+rtSunDiscSlope()*rtSunDiskRadius(i,radial)*
                (tangent*cos(angle)+bitangent*sin(angle)));
            rayQueryEXT query;
            rayQueryInitializeEXT(query,scene,gl_RayFlagsTerminateOnFirstHitEXT,255,
                world+n*.025+direction*.015,.01,direction,100.0);
            while(rayQueryProceedEXT(query)) {
                if(rayQueryGetIntersectionTypeEXT(query,false)==gl_RayQueryCandidateIntersectionTriangleEXT && opaqueHit(query))
                    rayQueryConfirmIntersectionEXT(query);
            }
            if(rayQueryGetIntersectionTypeEXT(query,true)==gl_RayQueryCommittedIntersectionTriangleEXT) {
                ++hitCount;
                uint kind=rayQueryGetIntersectionInstanceCustomIndexEXT(query,true)>>20;
                if(kind==2) atomicAdd(terrainHits,1);
                if(kind==1) atomicAdd(alphaHits,1);
                if(kind==3) atomicAdd(dynamicHits,1);
            }
        }
        atomicAdd(groupRays,4); atomicAdd(groupHits,hitCount);
        float fade=1-smoothstep(40.0,50.0,cameraDistance);
        float rtVisibility=1-float(hitCount)*.25*fade*ao.sun.w;
        return vec4(direct.rgb*max(0,direct.a-min(direct.a,rtVisibility)),p.z);
    }
    // Exactly one deterministic sun ray. Bounded tracing complements, never
    // replaces, CSM's distant and unsupported geometry coverage.
    rayQueryEXT query;
    vec3 direction=normalize(ao.sun.xyz);
    if(dot(n,direction)<0) n=-n;
    rayQueryInitializeEXT(query,scene,gl_RayFlagsTerminateOnFirstHitEXT,255,
        world+n*.025+direction*.015,.01,direction,100.0);
    while(rayQueryProceedEXT(query)) {
        if(rayQueryGetIntersectionTypeEXT(query,false)==gl_RayQueryCandidateIntersectionTriangleEXT && opaqueHit(query))
            rayQueryConfirmIntersectionEXT(query);
    }
    bool hit=rayQueryGetIntersectionTypeEXT(query,true)==gl_RayQueryCommittedIntersectionTriangleEXT;
    atomicAdd(groupRays,1); if(hit) atomicAdd(groupHits,1);
    if(hit) {
        uint kind=rayQueryGetIntersectionInstanceCustomIndexEXT(query,true)>>20;
        if(kind==2) atomicAdd(terrainHits,1);
        if(kind==1) atomicAdd(alphaHits,1);
        if(kind==3) atomicAdd(dynamicHits,1);
    }
    float fade=1-smoothstep(40.0,50.0,cameraDistance);
    float rtVisibility=hit?1-fade*ao.sun.w:1;
    return vec4(direct.rgb*max(0,direct.a-min(direct.a,rtVisibility)),p.z);
#else
    vec3 tangent=normalize(cross(abs(n.y)<.95?vec3(0,1,0):vec3(1,0,0),n));
    vec3 bitangent=cross(n,tangent);
    // Fixed, world-anchored rotation: no per-frame random flicker or history machinery.
    uvec3 cell=uvec3(ivec3(floor(world*64)));
    uint hash=cell.x*1597334677u ^ cell.y*3812015801u ^ cell.z*2798796415u;
    hash^=hash>>16; hash*=2246822519u; hash^=hash>>13;
    float angle=6.2831853*float(hash&65535u)/65536;
    float occlusion=0;
    uint hitCount=0;
    for(int i=0;i<4;++i) {
        float u=(float(i)+.5)/4;
        float phi=angle+float(i)*2.39996323;
        vec3 direction=tangent*cos(phi)*sqrt(u)+bitangent*sin(phi)*sqrt(u)+n*sqrt(1-u);
        rayQueryEXT query;
        rayQueryInitializeEXT(query,scene,0,5,
            world+n*ao.settings.y,.01,direction,ao.settings.x);
        while(rayQueryProceedEXT(query)) {
            if(rayQueryGetIntersectionTypeEXT(query,false)==gl_RayQueryCandidateIntersectionTriangleEXT && opaqueHit(query))
                rayQueryConfirmIntersectionEXT(query);
        }
        if(rayQueryGetIntersectionTypeEXT(query,true)==gl_RayQueryCommittedIntersectionTriangleEXT) {
            float distance=rayQueryGetIntersectionTEXT(query,true);
            occlusion+=1-smoothstep(0,ao.settings.x,distance);
            ++hitCount;
            if((rayQueryGetIntersectionInstanceCustomIndexEXT(query,true)>>20)==3) atomicAdd(dynamicHits,1);
        }
    }
    atomicAdd(groupRays,4); atomicAdd(groupHits,hitCount);
    float fade=1-smoothstep(ao.settings.w*.7,ao.settings.w,cameraDistance);
    return vec4(1-min(.55,occlusion*.25*ao.settings.z*fade),p.z,0,0);
#endif
}
void main() {
    if(gl_LocalInvocationIndex==0) { groupRays=0; groupHits=0; terrainHits=0; alphaHits=0; shadedHits=0; dynamicHits=0; dynamicShaded=0; }
#ifdef WATER_REFLECTION
    if(hitDiagnostics && gl_LocalInvocationIndex==0) { surfaceEligible=0; surfaceVertex=0; surfaceFace=0; surfaceUnavailable=0; surfaceInvalid=0; }
#endif
    barrier();
    ivec2 p=ivec2(gl_GlobalInvocationID.xy);
    if(all(lessThan(p,imageSize(resultAO))))
#ifdef WATER_REFLECTION
        imageStore(resultAO,p,traceWater(p));
#else
        imageStore(resultAO,p,traceAO(p));
#endif
    barrier();
    if(gl_LocalInvocationIndex==0) {
#ifdef WATER_REFLECTION
        atomicAdd(counters.waterRays,groupRays); atomicAdd(counters.waterHits,groupHits);
        atomicAdd(counters.shadedHits,shadedHits); atomicAdd(counters.shadedTerrain,terrainHits); atomicAdd(counters.shadedAlpha,alphaHits);
        atomicAdd(counters.dynamicWater,dynamicHits); atomicAdd(counters.dynamicShaded,dynamicShaded);
        if(hitDiagnostics) {
            atomicAdd(counters.surfaceEligible,surfaceEligible); atomicAdd(counters.surfaceVertex,surfaceVertex);
            atomicAdd(counters.surfaceFace,surfaceFace); atomicAdd(counters.surfaceUnavailable,surfaceUnavailable);
            atomicAdd(counters.surfaceInvalid,surfaceInvalid);
        }
#elif defined(SUN_SHADOW)
        atomicAdd(counters.sunRays,groupRays); atomicAdd(counters.sunHits,groupHits);
        atomicAdd(counters.terrainHits,terrainHits); atomicAdd(counters.alphaHits,alphaHits);
        atomicAdd(counters.dynamicSun,dynamicHits);
#else
        atomicAdd(counters.rays,groupRays); atomicAdd(counters.hits,groupHits);
        atomicAdd(counters.dynamicAO,dynamicHits);
#endif
    }
}
